{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wacko-bitsocial-relay",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_ROOM",
        "class_name": "BitSocialRelayRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["BitSocialRelayRoom"]
    }
  ]
}
